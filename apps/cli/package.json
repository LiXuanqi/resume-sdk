{
  "name": "resume-sdk",
  "version": "0.1.0-beta.1",
  "description": "Create, validate, preview, and export resumes from YAML or JSON.",
  "keywords": [
    "cv",
    "html",
    "pdf",
    "resume",
    "typescript"
  ],
  "homepage": "https://github.com/LiXuanqi/resume-sdk#readme",
  "bugs": {
    "url": "https://github.com/LiXuanqi/resume-sdk/issues"
  },
  "license": "MIT",
  "author": "Xuanqi Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiXuanqi/resume-sdk.git",
    "directory": "apps/cli"
  },
  "bin": {
    "resume-sdk": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@resume-sdk/core": "workspace:*",
    "@resume-sdk/pdf": "workspace:*",
    "@resume-sdk/providers": "workspace:*",
    "@resume-sdk/renderer": "workspace:*",
    "commander": "^14.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
