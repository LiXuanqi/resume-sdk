{
  "name": "resume-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Portable resume generation with validated data, templates, HTML, and PDF.",
  "keywords": [
    "cv",
    "html",
    "pdf",
    "resume",
    "typescript"
  ],
  "homepage": "https://github.com/LiXuanqi/resume-sdk#readme",
  "bugs": {
    "url": "https://github.com/LiXuanqi/resume-sdk/issues"
  },
  "license": "MIT",
  "author": "Xuanqi Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiXuanqi/resume-sdk.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "cli": "pnpm --filter resume-sdk start",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "pretest": "pnpm build",
    "test:pdf": "node tests/integration/pdf-smoke.mjs",
    "test:embed": "node tests/integration/embed-smoke.mjs",
    "test:package": "pnpm build && node tests/integration/packaged-consumer.mjs",
    "release:prepare": "pnpm build && node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
