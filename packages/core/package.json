{
  "name": "@resume-sdk/core",
  "version": "0.1.0-beta.2",
  "description": "Resume schema, YAML and JSON providers, templates, and HTML rendering.",
  "keywords": [
    "cv",
    "html",
    "pdf",
    "resume",
    "typescript"
  ],
  "homepage": "https://github.com/LiXuanqi/resume-sdk#readme",
  "bugs": {
    "url": "https://github.com/LiXuanqi/resume-sdk/issues"
  },
  "license": "MIT",
  "author": "Xuanqi Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiXuanqi/resume-sdk.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24"
  }
}
