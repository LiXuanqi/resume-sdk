{
  "name": "@resume-sdk/pdf",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Export resume HTML to PDF with Playwright and install its required Chromium browser.",
  "keywords": [
    "cv",
    "html",
    "pdf",
    "resume",
    "typescript"
  ],
  "homepage": "https://github.com/LiXuanqi/resume-sdk#readme",
  "bugs": {
    "url": "https://github.com/LiXuanqi/resume-sdk/issues"
  },
  "license": "MIT",
  "author": "Xuanqi Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiXuanqi/resume-sdk.git",
    "directory": "packages/pdf"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resume-sdk/renderer": "workspace:*",
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=24"
  }
}
